# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# نطاق البريد الوهمي الذي تُبنى عليه أسماء المستخدمين (يجب أن يطابق USERNAME_EMAIL_DOMAIN في Edge Function)
VITE_USERNAME_EMAIL_DOMAIN=users.hussas.local

# يُستخدم فقط في سكربت create-admin على جهازك. لا تضعه في الاستضافة ولا ترفعه إلى Git.
SUPABASE_SERVICE_ROLE_KEY=
